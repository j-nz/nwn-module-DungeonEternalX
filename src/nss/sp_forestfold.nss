#include "util_rangerspell"
void main(){if(!X2PreSpellCastCode())return;object oPC=OBJECT_SELF;AI_RemoveTaggedEffects(oPC,"AI_FORESTFOLD");int nCL=GetCasterLevel(oPC);if(nCL<1)nCL=1;float fDuration=600.0f*IntToFloat(nCL);if(GetMetaMagicFeat()==METAMAGIC_EXTEND)fDuration*=2.0f;effect e=EffectLinkEffects(EffectSkillIncrease(SKILL_HIDE,20),EffectSkillIncrease(SKILL_MOVE_SILENTLY,20));e=EffectLinkEffects(e,EffectVisualEffect(VFX_DUR_CESSATE_POSITIVE));e=TagEffect(e,"AI_FORESTFOLD");ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectVisualEffect(VFX_IMP_IMPROVE_ABILITY_SCORE),oPC);ApplyEffectToObject(DURATION_TYPE_TEMPORARY,e,oPC,fDuration);}
