#include "util_rangerspell"
void AI_CheckFavoredEnemy(int nFeat,int nRace,string sOne,string sMany){object oPC=OBJECT_SELF;if(!GetHasFeat(nFeat,oPC))return;location lLoc=GetLocation(oPC);object o=GetFirstObjectInShape(SHAPE_SPHERE,18.288f,lLoc,FALSE,OBJECT_TYPE_CREATURE);int n=0;while(GetIsObjectValid(o)){if(o!=oPC&&GetRacialType(o)==nRace){n++;ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectVisualEffect(VFX_IMP_REDUCE_ABILITY_SCORE),o);}o=GetNextObjectInShape(SHAPE_SPHERE,18.288f,lLoc,FALSE,OBJECT_TYPE_CREATURE);}if(n==1)SendMessageToPC(oPC,"You detect 1 "+sOne+" nearby.");else if(n>1)SendMessageToPC(oPC,"You detect "+IntToString(n)+" "+sMany+" nearby.");}
void main(){if(!X2PreSpellCastCode())return;
AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_ABERRATION,RACIAL_TYPE_ABERRATION,"aberration","aberrations");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_ANIMAL,RACIAL_TYPE_ANIMAL,"animal","animals");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_BEAST,RACIAL_TYPE_BEAST,"beast","beasts");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_CONSTRUCT,RACIAL_TYPE_CONSTRUCT,"construct","constructs");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_DRAGON,RACIAL_TYPE_DRAGON,"dragon","dragons");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_DWARF,RACIAL_TYPE_DWARF,"dwarf","dwarves");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_ELEMENTAL,RACIAL_TYPE_ELEMENTAL,"elemental","elementals");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_ELF,RACIAL_TYPE_ELF,"elf","elves");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_FEY,RACIAL_TYPE_FEY,"fey","fey");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_GIANT,RACIAL_TYPE_GIANT,"giant","giants");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_GNOME,RACIAL_TYPE_GNOME,"gnome","gnomes");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_GOBLINOID,RACIAL_TYPE_HUMANOID_GOBLINOID,"goblinoid","goblinoids");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_HALFELF,RACIAL_TYPE_HALFELF,"half-elf","half-elves");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_HALFLING,RACIAL_TYPE_HALFLING,"halfling","halflings");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_HALFORC,RACIAL_TYPE_HALFORC,"half-orc","half-orcs");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_HUMAN,RACIAL_TYPE_HUMAN,"human","humans");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_MAGICAL_BEAST,RACIAL_TYPE_MAGICAL_BEAST,"magical beast","magical beasts");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_MONSTROUS,RACIAL_TYPE_HUMANOID_MONSTROUS,"monstrous humanoid","monstrous humanoids");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_ORC,RACIAL_TYPE_HUMANOID_ORC,"orc","orcs");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_OUTSIDER,RACIAL_TYPE_OUTSIDER,"outsider","outsiders");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_REPTILIAN,RACIAL_TYPE_HUMANOID_REPTILIAN,"reptilian","reptilians");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_SHAPECHANGER,RACIAL_TYPE_SHAPECHANGER,"shapechanger","shapechangers");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_UNDEAD,RACIAL_TYPE_UNDEAD,"undead","undead");AI_CheckFavoredEnemy(FEAT_FAVORED_ENEMY_VERMIN,RACIAL_TYPE_VERMIN,"vermin","vermin");}
