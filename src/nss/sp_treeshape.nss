#include "util_rangerspell"
void main(){if(!X2PreSpellCastCode())return;object oPC=OBJECT_SELF;if(GetLocalInt(oPC,"AI_TREESHAPE_ACTIVE")){AI_EndTreeShape(oPC);return;}int nCL=GetCasterLevel(oPC);if(nCL<1)nCL=1;float fDuration=3600.0f*IntToFloat(nCL);if(GetMetaMagicFeat()==METAMAGIC_EXTEND)fDuration*=2.0f;string sTree;switch(d4()){case 1:sTree="x0_smallpine";break;case 2:sTree="plc_treeautumn";break;case 3:sTree="plc_tree";break;default:sTree="x0_deadtree";break;}effect e=EffectLinkEffects(EffectCutsceneGhost(),EffectCutsceneParalyze());e=EffectLinkEffects(e,EffectVisualEffect(VFX_DUR_CUTSCENE_INVISIBILITY));e=EffectLinkEffects(e,EffectImmunity(IMMUNITY_TYPE_CRITICAL_HIT));if(!GetIsInCombat(oPC))e=EffectLinkEffects(e,EffectEthereal());e=TagEffect(e,"AI_TREESHAPE");ApplyEffectToObject(DURATION_TYPE_INSTANT,EffectVisualEffect(VFX_IMP_POLYMORPH),oPC);ApplyEffectToObject(DURATION_TYPE_TEMPORARY,e,oPC,fDuration);object oTree=CreateObject(OBJECT_TYPE_PLACEABLE,sTree,GetLocation(oPC),FALSE,"AI_TREESHAPE_TREE");SetLocalObject(oPC,"AI_TREESHAPE_TREE",oTree);SetLocalInt(oPC,"AI_TREESHAPE_ACTIVE",TRUE);DelayCommand(fDuration,AI_EndTreeShape(oPC));}
